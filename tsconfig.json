{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "preserveConstEnums": true,
    "removeComments": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "strict": true,
    "outDir": "./dist",
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["esnext"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "*": ["./src/*"] }
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules"]
}
